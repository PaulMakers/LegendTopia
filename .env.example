# ========================================================
# Konfigurasi Environment LegendTopia GTPS
# Salin file ini menjadi .env pada saat pengembangan lokal
# ========================================================

# Port server untuk pengembangan lokal (default: 3000)
PORT=3000

# Secret Key utama untuk validasi Heartbeat GTPS Lua dan Admin Login
# Pastikan nilai ini dirahasiakan dan cocok dengan yang dipasang di script Lua server game
GTPS_SECRET=193679634487

# URL REST API Upstash Redis (Dapatkan di https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io

# Token REST API Upstash Redis
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
